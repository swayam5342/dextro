# Run `make env` to create .env with random values. The server refuses to start
# with the placeholder below.
POSTGRES_PASSWORD=changeme
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme

# Optional. The address browsers use; changing requests from anywhere else are
# refused. Defaults to http://127.0.0.1:3000.
# PUBLIC_URL=https://files.example.org

# Optional. Both turn on Google sign-in. In the Google Cloud console, add
# <PUBLIC_URL>/api/v1/auth/google/callback as an authorized redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
