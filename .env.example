# Run `make env` to create .env with random values. The server refuses to start
# with the placeholder below.
POSTGRES_PASSWORD=changeme
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme

# Encrypts stored storage credentials. Back this up: without it, every connected
# account has to be set up again. The format is id:base64, for 32 random bytes.
# To rotate, add a new key after a comma and set ENCRYPTION_KEY_ID to its id.
ENCRYPTION_KEYS=changeme

# Optional. The address browsers use; changing requests from anywhere else are
# refused. Defaults to http://127.0.0.1:3000.
# PUBLIC_URL=https://files.example.org

# Optional. Both turn on Google sign-in. In the Google Cloud console, add
# <PUBLIC_URL>/api/v1/auth/google/callback as an authorized redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional. S3 endpoints allowed to be on a private address, as host or host:port.
# Only list hosts you trust. Defaults to the dev SeaweedFS.
# S3_ALLOWED_HOSTS=seaweedfs,nas.local:9000
