# Run `make env` to create .env with random values. The server refuses to start
# with the placeholder below.
POSTGRES_PASSWORD=changeme

# Encrypts stored Google tokens. Back this up: without it, every linked account
# has to be connected again. The format is id:base64, for 32 random bytes.
# To rotate, add a new key after a comma and set ENCRYPTION_KEY_ID to its id.
ENCRYPTION_KEYS=changeme

# Optional. The address browsers use; changing requests from anywhere else are
# refused. Defaults to http://127.0.0.1:3000.
# PUBLIC_URL=https://files.example.org

# Optional. If a reverse proxy sits in front of the web service, its address or range,
# so visitors' real addresses reach the rate limits and the audit log.
# TRUSTED_PROXIES=172.30.0.1

# Both turn on Google sign-in and linking Drive accounts, which is where Tributary
# stores files. In the Google Cloud console, add these authorized redirect URIs:
#   <PUBLIC_URL>/api/v1/auth/google/callback
#   <PUBLIC_URL>/api/v1/storage/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Turns on Add from Drive. Needs the Google Picker API enabled in the same project.
# GOOGLE_PICKER_API_KEY=
